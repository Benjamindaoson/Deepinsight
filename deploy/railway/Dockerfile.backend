FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/srv/app PORT=8080
WORKDIR /srv
COPY app/requirements-product.lock.txt /tmp/requirements.lock.txt
RUN pip install --no-cache-dir -r /tmp/requirements.lock.txt
COPY app /srv/app
COPY b1 /srv/b1
COPY seed-data/market.sqlite3 /srv/seed-data/market.sqlite3
COPY seed-data/artifacts /srv/seed-data/artifacts
COPY seed-data/originals /srv/seed-data/originals
COPY seed-data/source-qualification /srv/seed-data/source-qualification
COPY deploy/railway/backend_entry.py /srv/deploy/railway/backend_entry.py
EXPOSE 8080
CMD ["python", "deploy/railway/backend_entry.py"]
