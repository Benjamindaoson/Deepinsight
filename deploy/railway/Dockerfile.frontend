FROM node:22-alpine AS build
WORKDIR /web
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG NEXT_PUBLIC_AGENT_OS_URL
ARG NEXT_PUBLIC_MARKET_API_URL
ARG LONDON_BACKEND_PRIVATE_URL
ENV NEXT_PUBLIC_AGENT_OS_URL=$NEXT_PUBLIC_AGENT_OS_URL
ENV NEXT_PUBLIC_MARKET_API_URL=$NEXT_PUBLIC_MARKET_API_URL
ENV LONDON_BACKEND_PRIVATE_URL=$LONDON_BACKEND_PRIVATE_URL
RUN pnpm build

FROM node:22-alpine
WORKDIR /web
RUN corepack enable
COPY --from=build /web /web
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["sh", "-c", "pnpm exec next start -H 0.0.0.0 -p ${PORT:-3000}"]
