# Copy only the settings you need into a local, Git-ignored .env or server-side configuration.
# The offline saved-evidence API does not require any of these credentials.
# Optional live model provider. Offline mode requires none of these.
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEFAULT_MODEL=

# Optional notification destination (Apprise URL). Empty means no delivery.
LONDON_NOTIFICATION_URL=

# Optional search adapter; disabled unless explicitly enabled.
LONDON_TAVILY_API_KEY=
LONDON_TAVILY_ENABLED=0

# Optional classifier/shadow provider. Use a dedicated key.
LONDON_JEV_API_KEY=
LONDON_JEV_MODEL=jev-1.13.0
LONDON_JEV_TIMEOUT_SECONDS=2
LONDON_JEV_MAX_PENDING=4
LONDON_JEV_MAX_CALLS=100
LONDON_JEV_SHADOW_ENABLED=0
LONDON_JEV_ROUTING_ENABLED=0

# Optional official EPC API token.
LONDON_EPC_TOKEN=

# Frontend build-time loopback endpoints. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_MARKET_API_URL=http://127.0.0.1:8000/api/market
NEXT_PUBLIC_AGENT_OS_URL=http://127.0.0.1:8000
DEEPINSIGHT_NEXT_DIST_DIR=.next
