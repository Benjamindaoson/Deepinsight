# SERVER environment only. Never add credentials to frontend NEXT_PUBLIC variables.
# Live deployments inject model settings through process or service secrets.
# Optional Apprise destination. Example is intentionally empty; no send occurs.
LONDON_NOTIFICATION_URL=
# New, dedicated Tavily key only. Generic TAVILY_API_KEY is never inherited.
# Configure a NEW key locally; do not paste credentials into chat or commit them.
LONDON_TAVILY_API_KEY=
# Enable only after local key setup and search-credit authorization.
LONDON_TAVILY_ENABLED=0
# One fast search per UTC-aligned six-hour window, max 5 candidates, no retries.
# Existing london-news schedule consumes it; no additional schedule is created.
# Supply this process environment securely before starting the runtime. This file
# is an example, not an automatically loaded secret store.

# Jev Shadow Mode: server environment only; disabled by default.
# When enabled, sends the current ask question to the official TypeSafe API.
# Suggestions never control execution. Never reuse the answer-model API key.
LONDON_JEV_SHADOW_ENABLED=0
LONDON_JEV_API_KEY=
LONDON_JEV_MODEL=jev-1.13.0
LONDON_JEV_TIMEOUT_SECONDS=2
LONDON_JEV_MAX_PENDING=4
# Per-process admitted observation cap (including failures); no automatic retries.
LONDON_JEV_MAX_CALLS=100

# Active query/node classification: disabled by default, requires dedicated key.
# Clear local lookups and explicit saved/agent modes bypass the classifier.
# Missing key/low confidence/provider failures use the existing execution path.
# Set 0 to restore the original auto rules. Shadow mode stays independent.
LONDON_JEV_ROUTING_ENABLED=0
# Optional ignored project config: ../secrets/jev.json.
# Copy config.jev.example.json there and set api_key locally when available.

# Optional isolated provider calibration; requires NEW actual usage receipts and hashes.
# LONDON_TOKEN_CALIBRATION_PATH=D:/deepinsight-lite/docs/delivery/<acceptance>/token-calibration.json
# Never relabel legacy samples. Default calibration and secrets/model.json remain unchanged.
