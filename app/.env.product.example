# SERVER environment only. Never add credentials to frontend NEXT_PUBLIC variables.
# Existing authorized model identity is read from ../secrets/model.json.
# Optional Apprise destination. Example is intentionally empty; no send occurs.
LONDON_NOTIFICATION_URL=
# New, dedicated Tavily key only. Generic TAVILY_API_KEY is never inherited.
# Configure a NEW key locally; do not paste credentials into chat or commit them.
LONDON_TAVILY_API_KEY=
# Enable only after local key setup and search-credit authorization.
LONDON_TAVILY_ENABLED=0
# One fast search per UTC-aligned six-hour window, max 5 candidates, no retries.
# Existing london-news schedule consumes it; no additional schedule is created.
# Supply this process environment securely before starting the runtime. This file
# is an example, not an automatically loaded secret store.

# product-start.ps1 also loads project-local secrets/tavily.json when present.
# JSON shape: {"api_key":"YOUR_NEW_KEY","enabled":true}; this overrides env.
